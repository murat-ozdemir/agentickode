# .env.mem0 — mem0 sunucusunun gizli degerleri (docker-compose.bimetri.yml).
# Kopyala: cp .env.mem0.example .env.mem0 && chmod 600 .env.mem0
# Degerleri sohbete/commit'e yapistirma; dosyayi sunucuda duzenle.

# Postgres'te "mem0" kullanicisinin parolasi (migrate-to-pgvector.sh bu kullaniciyi olusturur).
POSTGRES_PASSWORD=

# Bellek cikarma (LLM) ve vektor (embedding) icin.
OPENAI_API_KEY=
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# API erisimi: istemciler X-API-Key basligiyla gonderir. En az 32 karakter.
# Uret: openssl rand -hex 32
ADMIN_API_KEY=
JWT_SECRET=
